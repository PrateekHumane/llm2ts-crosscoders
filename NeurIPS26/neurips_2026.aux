\newlabel{sec:reuse_vs_reinvent}{{5.3}{5}{Reuse vs.\ Reinvention: FT and RI Find Different Solutions}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Geometric evidence for direction reuse.} \textbf  {(Left)} Effective rank across layers. FT compresses TS representations to $\sim $12 dimensions (green solid), far below PT's $\sim $44 (blue solid) and RI's $\sim $35 (purple solid). Text$\to $FT collapses to $\sim $2.5 (catastrophic forgetting). \textbf  {(Right)} Subspace alignment: mean principal angle between top-10 PCs. ts@PT$\leftrightarrow $ts@FT (purple) stays well below the random baseline (85.3$^\circ $), confirming FT reuses PT's directions. Tables~\ref {tab:effrank} and~\ref {tab:alignment} in Appendix.}}{6}{figure.caption.26}\protected@file@percent }
\newlabel{fig:geometry}{{3}{6}{\textbf {Geometric evidence for direction reuse.} \textbf {(Left)} Effective rank across layers. FT compresses TS representations to $\sim $12 dimensions (green solid), far below PT's $\sim $44 (blue solid) and RI's $\sim $35 (purple solid). Text$\to $FT collapses to $\sim $2.5 (catastrophic forgetting). \textbf {(Right)} Subspace alignment: mean principal angle between top-10 PCs. ts@PT$\leftrightarrow $ts@FT (purple) stays well below the random baseline (85.3$^\circ $), confirming FT reuses PT's directions. Tables~\ref {tab:effrank} and~\ref {tab:alignment} in Appendix}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Reuse vs.\ reinvention.} \textbf  {(Left)} A sine wave (period 64) through FT (top) and RI (bottom) across layers, shown as 2D PCA of hidden-state trajectories colored by input phase. Percentages show variance explained by 2 PCs. FT's loops are geometrically complex (inherited from pretraining) while RI discovers clean, symmetric circles from scratch. At Layer~8, FT captures 51\% of variance in 2D vs.\ RI's 29\%---FT concentrates periodic structure into fewer dimensions. \textbf  {(Right)} Phase coherence (ratio of same-phase to all-pairs distance, computed in the full 1024-dim hidden space; lower = more periodic). FT represents periodicity most explicitly at all tested inputs.}}{6}{figure.caption.28}\protected@file@percent }
\newlabel{fig:reuse}{{4}{6}{\textbf {Reuse vs.\ reinvention.} \textbf {(Left)} A sine wave (period 64) through FT (top) and RI (bottom) across layers, shown as 2D PCA of hidden-state trajectories colored by input phase. Percentages show variance explained by 2 PCs. FT's loops are geometrically complex (inherited from pretraining) while RI discovers clean, symmetric circles from scratch. At Layer~8, FT captures 51\% of variance in 2D vs.\ RI's 29\%---FT concentrates periodic structure into fewer dimensions. \textbf {(Right)} Phase coherence (ratio of same-phase to all-pairs distance, computed in the full 1024-dim hidden space; lower = more periodic). FT represents periodicity most explicitly at all tested inputs}{figure.caption.28}{}}
