\@writefile{toc}{\contentsline {section}{\numberline {4}Evidence for the Shared Manifold}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}The manifold is low-dimensional}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Representation geometry. Effective rank $= \exp (-\DOTSB \sum@ \slimits@ p_i \log p_i)$ where $p_i = \lambda _i / \mathrm  {Tr}(\Sigma )$. Pretraining compresses 28{,}672 dimensions into $\sim $3--6 effective dimensions. Random initialization yields near-isotropic geometry.}}{3}{table.caption.14}\protected@file@percent }
\newlabel{tab:pca}{{3}{3}{Representation geometry. Effective rank $= \exp (-\sum p_i \log p_i)$ where $p_i = \lambda _i / \mathrm {Tr}(\Sigma )$. Pretraining compresses 28{,}672 dimensions into $\sim $3--6 effective dimensions. Random initialization yields near-isotropic geometry}{table.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Why the manifold aligns with time series}{4}{subsection.4.2}\protected@file@percent }
